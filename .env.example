# BrandShield.ai environment variables. Copy to .env and fill in values.
# Never commit real keys. All keys live in environment variables only.

# SQLite for the local demo (default). Use a Postgres URL in production.
BRANDSHIELD_DB_URL=sqlite:./data/brandshield.db
# Example Postgres (requires a Postgres driver installed separately):
# BRANDSHIELD_DB_URL=postgres://user:password@localhost:5432/brandshield

BRANDSHIELD_PORT=4100
BRANDSHIELD_WEB_ORIGIN=http://localhost:5173
# Public origin used inside verification and password-reset links.
# In production set this to the address people actually open.
BRANDSHIELD_PUBLIC_URL=http://localhost:5173
BRANDSHIELD_SESSION_DAYS=7
BRANDSHIELD_UPLOAD_DIR=./data/uploads
BRANDSHIELD_MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# AI providers (all optional)
# ---------------------------------------------------------------------------
# "auto" uses the first configured keyed provider (Gemini → Groq → OpenRouter
# → custom OpenAI-compatible), otherwise MOCK. Pollinations is never selected
# by auto because it is external and keyless.
#
# Keys can only come from these server-side variables. They cannot be created
# or embedded through the browser.
BRANDSHIELD_LLM_PROVIDER=auto
BRANDSHIELD_LLM_API_KEY=your-key-here
BRANDSHIELD_LLM_MODEL=gpt-4o-mini
BRANDSHIELD_LLM_BASE_URL=https://api.openai.com/v1
BRANDSHIELD_LLM_TIMEOUT_MS=8000

# Google Gemini (free tier)
BRANDSHIELD_GEMINI_API_KEY=
BRANDSHIELD_GEMINI_MODEL=gemini-2.0-flash

# Groq (free tier)
BRANDSHIELD_GROQ_API_KEY=
BRANDSHIELD_GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (free models)
BRANDSHIELD_OPENROUTER_API_KEY=
BRANDSHIELD_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Pollinations (no key). Lower reliability; select it explicitly in Settings.
BRANDSHIELD_POLLINATIONS_MODEL=openai

# Email delivery. "mock" writes messages to the server console and the
# admin-only Settings → Sent emails panel. No SMTP service is contacted.
BRANDSHIELD_EMAIL_PROVIDER=mock

# Seed demo password for every Northwind Labs demo account.
BRANDSHIELD_DEMO_PASSWORD=BrandShield!23

# Optional first-admin bootstrap values for `npm run create-admin`.
# When omitted, the command prompts for them.
# BRANDSHIELD_ADMIN_EMAIL=you@company.example
# BRANDSHIELD_ADMIN_NAME=Your Name
# BRANDSHIELD_ADMIN_TEAM=Brand
# BRANDSHIELD_ADMIN_PASSWORD=ChooseAStrongOne!23
